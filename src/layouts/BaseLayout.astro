---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '../styles/tokens.css';
import '../styles/global.css';
import interUrl from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter500Url from '@fontsource/inter/files/inter-latin-500-normal.woff2?url';
import inter600Url from '@fontsource/inter/files/inter-latin-600-normal.woff2?url';
import inter700Url from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ar';
  dir?: 'ltr' | 'rtl';
  path?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  alternates?: { lang: string; path: string }[];
  /** A 1200×630 PNG under public/, made by `npm run og`. */
  image?: string;
}

const { title, description, lang = 'en', dir = 'ltr', path = '/', noindex = false, jsonLd, alternates = [], image = '/og.png' } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const skipLabel = lang === 'ar' ? 'انتقل إلى المحتوى' : 'Skip to content';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.path, Astro.site).href} />)}
    <meta name="theme-color" content="#0c1222" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter500Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter600Url} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter700Url} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <slot />
  </body>
</html>
