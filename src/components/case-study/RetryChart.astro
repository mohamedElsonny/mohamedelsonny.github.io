---
import { RETRY_CHART, type ChartSeries } from './ingestion';

interface Props {
  title: string;
  note: string;
  jitterLabel: string;
  r429Label: string;
  axis: { x: string; y: string };
  limitLabel: string;
  retryAfterLabel: string;
  firstLabel: string;
  captions: Record<ChartSeries, { heading: string; text: string }>;
}

const { title, note, jitterLabel, r429Label, axis, limitLabel, retryAfterLabel, firstLabel, captions } = Astro.props;
const { series } = RETRY_CHART;

const SERIES: ChartSeries[] = ['plain', 'jitter', 'plain429', 'jitter429'];
const TICKS = [0, 5, 10, 15];

/* Plot geometry (spec §7.5): 20 one-second buckets from x 40 to 470, 20px per request. */
const BAR_STEP = 21.5;
const BAR_WIDTH = 14;
const BASELINE = 180;
const PX_PER_REQUEST = 20;
const barX = (t: number) => 40 + t * BAR_STEP + (BAR_STEP - BAR_WIDTH) / 2;
const bucketX = (t: number) => 40 + t * BAR_STEP + BAR_STEP / 2;
const barClass = (t: number) => (t === 0 ? 'rchart__bar rchart__bar--first' : 'rchart__bar');
---

<div class="rchart" data-jitter="off" data-r429="off">
  <p class="rchart__title">{title}</p>
  <p class="rchart__note">{note}</p>
  <div class="rchart__switches">
    <div class="rchart__switch">
      <button type="button" role="switch" aria-checked="false" aria-labelledby="rchart-jitter" data-key="jitter" />
      <span id="rchart-jitter">{jitterLabel}</span>
    </div>
    <div class="rchart__switch">
      <button type="button" role="switch" aria-checked="false" aria-labelledby="rchart-r429" data-key="r429" />
      <span id="rchart-r429">{r429Label}</span>
    </div>
  </div>
  <svg class="rchart__svg" viewBox="0 0 480 220" aria-hidden="true">
    <line class="rchart__axis" x1="40" y1={BASELINE} x2="470" y2={BASELINE} />
    <line class="rchart__limit" x1="40" y1="60" x2="470" y2="60" />
    <text class="rchart__limit-label" x="470" y="54" text-anchor="end">{limitLabel}</text>
    <text class="rchart__first-label" x="40" y="13">{firstLabel}</text>
    {
      SERIES.map((s) => (
        <g data-series={s}>
          {s === 'plain429' || s === 'jitter429' ? (
            <>
              <rect class="rchart__band" x="61.5" y="20" width="86" height="160" />
              <text class="rchart__band-label" x="104.5" y="110" text-anchor="middle">
                {retryAfterLabel}
              </text>
            </>
          ) : null}
          {series[s].map((v, t) => (
            <rect class={barClass(t)} data-t={t} data-v={v} x={barX(t)} y={BASELINE - v * PX_PER_REQUEST} width={BAR_WIDTH} height={v * PX_PER_REQUEST} />
          ))}
        </g>
      ))
    }
    {
      TICKS.map((t) => (
        <>
          <line class="rchart__tick" x1={bucketX(t)} y1={BASELINE} x2={bucketX(t)} y2="185" />
          <text class="rchart__tick-label" x={bucketX(t)} y="197" text-anchor="middle">
            {t}
          </text>
        </>
      ))
    }
    <text class="rchart__axis-title" x="255" y="214" text-anchor="middle">{axis.x}</text>
    <text class="rchart__axis-title" transform="rotate(-90 12 100)" x="12" y="100" text-anchor="middle">{axis.y}</text>
  </svg>
  <div class="rchart__caps" aria-live="polite">
    {
      SERIES.map((s) => (
        <div class="rchart__cap" data-cap={s}>
          <p class="rchart__cap-title">{captions[s].heading}</p>
          <p>{captions[s].text}</p>
        </div>
      ))
    }
  </div>
</div>

<script>
  for (const chart of document.querySelectorAll<HTMLElement>('.rchart')) {
    chart.addEventListener('click', (event) => {
      const toggle = (event.target as HTMLElement).closest<HTMLElement>('[role="switch"]');
      if (!toggle) return;
      const on = toggle.getAttribute('aria-checked') !== 'true';
      toggle.setAttribute('aria-checked', String(on));
      chart.setAttribute(`data-${toggle.dataset.key}`, on ? 'on' : 'off');
    });
  }
</script>
